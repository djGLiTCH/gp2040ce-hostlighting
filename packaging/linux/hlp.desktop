# A desktop entry for the hlp app, which opens it in a terminal to show its menu, with hlp.png as the icon named
# hlp. The README's install writes the full path of hlp in place of Exec=hlp.
[Desktop Entry]
Type=Application
Name=hlp
Comment=GP2040-CE Host Lighting tools
Exec=hlp
Icon=hlp
Terminal=true
Categories=Utility;
